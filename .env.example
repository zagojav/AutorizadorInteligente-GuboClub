# Copie para .env (que NAO vai pro git) e preencha o que precisar.
# Sem nenhuma destas variaveis o projeto sobe e funciona: a IA cai no template.

# Chave da Anthropic. Fica so no servidor: nunca vai pra log, resposta ou front.
ANTHROPIC_API_KEY=

# Modelo usado pra redigir o texto das tarefas. Padrao: claude-haiku-4-5.
IA_MODELO=claude-haiku-4-5

# Porta e host do servidor. Host padrao 127.0.0.1 (demo publica vai por tunel).
PORT=3000
HOST=127.0.0.1

# Arquivo do banco SQLite.
BANCO_ARQUIVO=gubo_autorizador.db

# Depuracao local: 1 devolve o detalhe tecnico do erro na resposta. Deixe vazio.
DETALHAR_ERROS=
